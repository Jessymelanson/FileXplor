<?xml version="1.0" encoding="utf-8"?>
<!--
    The icon a pinned folder gets on the phone's home screen.

    Same 108-unit canvas and the same folder silhouette as the app icon, drawn
    to the same 38-on-54,54 measurement, so the two are obviously from the same
    app. The colour is the one deliberate difference: the app icon is rose, and
    an identical rose folder sitting next to it would be two icons that look
    like the same thing and do different ones. Slate reads as "a folder" rather
    than as a second copy of FileXplor, and launchers badge a pinned shortcut
    with the app's own icon anyway, so nothing is lost by not repeating it.

    Full-bleed background with the glyph inside the middle 72 units, because an
    adaptive icon is masked to whatever shape the launcher uses and only that
    centre square is guaranteed to survive.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#5B6B82"
                android:endColor="#28313F" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,39h11l5,6h17a3,3 0,0 1,3 3v18a3,3 0,0 1,-3 3h-33a3,3 0,0 1,-3 -3v-24a3,3 0,0 1,3 -3z" />
</vector>
