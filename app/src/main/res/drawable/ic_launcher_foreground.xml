<?xml version="1.0" encoding="utf-8"?>
<!--
    The folder. See JPhone's foreground for why every glyph in the family is one
    flat white silhouette, and for the 38-on-54,54 measurement they are built to.

    A folder is wider than it is tall, so it is fitted to the diagonal of that
    box rather than its width: 39 across by 30 down measures the same to the eye
    as a 38-square glyph, where 38 across would look oversized beside the
    upright shapes the other five use.

    Drawn as one path with the tab cut into the top edge rather than as a body
    plus a tab. Two overlapping shapes need the same fill rule agreement that
    the animated backdrops in this family kept getting wrong, and a silhouette
    this simple has no reason to risk it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,39h11l5,6h17a3,3 0,0 1,3 3v18a3,3 0,0 1,-3 3h-33a3,3 0,0 1,-3 -3v-24a3,3 0,0 1,3 -3z" />
</vector>
