<?xml version="1.0" encoding="utf-8"?>
<!--
    The icon's ground. Shared, to the pixel, with the rest of the family — only
    the two colours differ.

    A flat fill reads as unfinished next to the gradients every other launcher
    icon uses, so this ramps across the diagonal. The ramp runs 18..90 rather
    than 0..108 because only the middle 72 units are guaranteed to survive the
    launcher's mask — spreading it over the full canvas would waste most of the
    range on pixels nobody sees, leaving the visible face looking flat again.
    Outside that span the gradient clamps, which is exactly what the masked
    corners want.

    Rose, because it is the one gap left in the family's hue circle: JAuth is
    green, JPhone teal, JCalendar blue, JPhotos purple and JNotes amber. Coral
    was the first choice and sat about thirty degrees from JNotes, which at
    icon size is the same colour twice. This sits fifty from amber and ninety
    from purple, so the six are still told apart on a home screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#F2536B"
                android:endColor="#8E1633" />
        </aapt:attr>
    </path>
</vector>
