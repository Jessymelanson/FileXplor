<?xml version="1.0" encoding="utf-8"?>
<!--
    What must never leave the phone, for Android 11 and below.

    This file holds ciphertext produced by a key that lives in the Android
    Keystore, and a Keystore key is not exportable - it does not go into a
    backup and it does not survive a device transfer. Backing up the ciphertext
    therefore restores something that can never be decrypted again: saved
    servers whose passwords silently read as empty. Failing quietly on a new
    phone is worse than not being restored at all.

    The unlock prompt in front of these servers needs no exclusion of its own:
    it stores nothing, holding only an in-memory flag that is cleared when the
    app stops being visible.

    Everything else is still backed up. This excludes the encrypted file only.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="filexplor_servers.xml" />
</full-backup-content>
