<?xml version="1.0" encoding="utf-8"?>
<!--
    The same exclusions for Android 12 and above, which replaced
    fullBackupContent with this file and split it in two.

    Device transfer is excluded as well as cloud backup, and deliberately: a
    Keystore key does not move between devices even on a direct handset-to-
    handset transfer, so the ciphertext would arrive just as unreadable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="filexplor_servers.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="filexplor_servers.xml" />
    </device-transfer>
</data-extraction-rules>
