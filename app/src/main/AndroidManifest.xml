<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for the built-in FTP/SFTP/SMB clients. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
         Asked for at the first copy, not at launch.

         A running transfer is the only thing this app ever posts, so the
         prompt means something the moment there is one and means nothing
         before that. Refused, everything still works: JobNotifications checks
         and goes quiet, and the bar inside the app is unaffected.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
         For TransferService, which holds the process together while a copy
         runs with the screen off. See that class for what each one answers:
         the wake lock stops the CPU suspending mid-socket-read, and the
         foreground service is what keeps Doze from cutting the network and
         the system from reclaiming the process.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
         Handing an APK to Android's package installer.

         Without it the installer refuses the intent outright: from Android 8 the
         permission to install is per-app, and a file manager that cannot open an
         APK is missing the one thing people sideload a file manager to do.
         Android still shows its own confirmation, and still asks the user to
         allow this app as a source the first time.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
         Reading and writing shared storage.

         The legacy pair is capped at API 32. From API 33 they grant nothing at
         all: Android split reading into per-media permissions and stopped
         honouring the broad ones, so asking for them on a modern phone is noise
         in the permission list that can never be satisfied.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
         The permission that makes this a file manager rather than a picker.

         Scoped storage lets an app see media it can name and its own sandbox.
         Neither is a file explorer: browsing Download, following a folder
         somebody else's app made, moving a zip out of it — none of that is
         reachable without this. It is the same permission every file manager on
         the store holds, and Google lists file managers as a use it will accept.

         Declared with tools:ignore because lint flags it on sight, which is the
         right default for almost every app and wrong for this one.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:name=".FileXplorApp"
        android:theme="@style/Theme.FileXplor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FileXplor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             Not exported and never started from outside: the view model starts
             it from the tap that begins a transfer and stops it when the
             transfer ends. dataSync is the type that fits — this is moving
             bytes between two places on the user's behalf, which is what that
             category is for.
        -->
        <service
            android:name=".data.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
             Handing a file to another app.

             A file manager's whole job ends with "open this in something else",
             and a bare file:// URI has thrown FileUriExposedException since
             Android 7. The provider turns a path into a content:// URI the
             receiving app can actually read.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
